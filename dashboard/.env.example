# Dashboard environment variables
# Copy this to .env and fill in the values.
# This file is gitignored — generated automatically by the deploy workflow.

# Same bot token as the main bot (used to send OTP codes)
BOT_TOKEN=your_bot_token_here

# MongoDB connection string (same as main bot)
MONGO_URI=mongodb://localhost:27017

# MongoDB database name
MONGO_DATABASE=finances

# JSON list of admin Telegram IDs who can log into the dashboard
BOT_ADMIN_IDS=[123456789]

# Secret key for JWT signing — generate with: openssl rand -hex 32
DASHBOARD_SECRET_KEY=change_me_to_a_random_64_char_hex_string
