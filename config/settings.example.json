{
  "bot": {
    "token": "YOUR_TELEGRAM_BOT_TOKEN",
    "admin_ids": [
      123456789
    ],
    "version": "finances v6.0 'black & blue'"
  },
  "database": {
    "mongo_uri": "mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=your-app",
    "mongo_database": "finances",
    "pool_min": 5,
    "pool_max": 50
  },
  "api_keys": {
    "crypto": "YOUR_CRYPTO_API_KEY",
    "stocks": "YOUR_STOCKS_API_KEY"
  },
  "urls": {
    "github": "https://github.com/your-username/finances",
    "communication": "https://t.me/your_username",
    "invite": "https://t.me/your_bot?startgroup=true",
    "buymeacoffee": "",
    "donatello": "",
    "bank": "",
    "mini_app": ""
  },
  "i18n": {
    "supported_languages": [
      "en",
      "uk",
      "pl",
      "cs",
      "sk",
      "de",
      "fr"
    ],
    "default_language": "en"
  },
  "parser": {
    "auto_update": true,
    "update_interval_sec": 3600,
    "fiat_source_url": "https://fx-rate.net",
    "retry_attempts": 3,
    "retry_delay_sec": 5,
    "request_delay_min_sec": 3,
    "request_delay_max_sec": 7,
    "critical_currencies": [
      "USD",
      "EUR",
      "GBP",
      "UAH",
      "PLN",
      "CZK",
      "CHF",
      "CNY",
      "JPY",
      "CAD",
      "AUD",
      "SEK",
      "NOK",
      "DKK",
      "SGD",
      "INR",
      "ILS",
      "KRW",
      "TRY",
      "RON",
      "BGN",
      "ISK",
      "EGP",
      "ARS",
      "RUB"
    ],
    "on_demand_cache_ttl_hours": 5,
    "crypto_stocks_interval_sec": 10800
  },
  "security": {
    "rate_limit_requests": 30,
    "rate_limit_window_sec": 60,
    "max_message_length": 1000,
    "fernet_key": "YOUR_FERNET_KEY"
  },
  "features": {
    "mini_app_enabled": false,
    "groups_enabled": true,
    "inline_mode_enabled": true
  },
  "draft": {
    "enabled": true,
    "loading_threshold_sec": 0.05,
    "animation_interval_sec": 0.25,
    "preview_delay_sec": 0.15
  }
}