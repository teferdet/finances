# ==============================================================================
# Finances Project — Unified Environment Configuration (.env)
# ==============================================================================
# Copy this file to .env and fill in the required credentials.
#
# cp .env.example .env
# ==============================================================================

# ── Telegram Bot ──────────────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here
BOT_ADMIN_IDS=[123456789]
BACKUP_ENABLED=true

# ── Database (MongoDB) ────────────────────────────────────────────────────────
# Dedicated / External MongoDB server connection string (Atlas or remote server):
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/finances?appName=finances
MONGO_DATABASE=finances
DB_POOL_MIN=5
DB_POOL_MAX=50

# ── API Keys ──────────────────────────────────────────────────────────────────
# CoinMarketCap API key for crypto prices
CRYPTO_API_KEY=
# Stocks API key
STOCKS_API_KEY=

# ── Security & Encryption ─────────────────────────────────────────────────────
# Fernet key for encrypting user exchange API secrets
FERNET_KEY=
# Optional 32-byte key for encrypting backup archives (base64 or 64 hex chars).
# Generate with: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Keep this key OUT of the server; without it backups cannot be restored.
BACKUP_ENCRYPTION_KEY=
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SEC=60

# ── Cache (Redis) ─────────────────────────────────────────────────────────────
# Optional Redis cache (falls back to memory cache if empty)
REDIS_URL=redis://redis:6379/0


# ── Features ──────────────────────────────────────────────────────────────────
MINI_APP_ENABLED=false
GROUPS_ENABLED=true
INLINE_MODE_ENABLED=true

# ── External URLs ─────────────────────────────────────────────────────────────
URL_GITHUB=https://github.com/your-username/finances
URL_COMMUNICATION=https://t.me/your_username
URL_INVITE=https://t.me/your_bot?startgroup=true
URL_BUYMEACOFFEE=
URL_DONATELLO=
URL_BANK=
URL_MINI_APP=
