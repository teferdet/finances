[Unit]
Description=Finances Telegram Bot
After=network.target mongod.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/finances-dev
Environment=PYTHONUNBUFFERED=1

# Start the bot as a process named "finances.bot"
ExecStart=/bin/bash -c 'exec -a finances.bot /home/ubuntu/finances-dev/venv/bin/python -m app'

# Restart policy
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=finances-bot

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/finances-dev

[Install]
WantedBy=multi-user.target
